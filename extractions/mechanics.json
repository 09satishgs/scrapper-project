  "god_trials": [
    {
      "trial_name": "Kalla's Trial",
      "god": "Kalla",
      "unlock_condition": "Complete Kalla's Request in Part 3.",
      "enemy_buffs": [
        "Any Master Class",
        "Any Divine Class Hong Hua Troy Guzran"
      ],
      "rewards": [
        "Kalla's Needle"
      ],
      "strategy": "Kalla's Trial is arguably the hardest one of the six since you have to deal with enemy units that have increased Avoid and Speed. Check your available units and bring ones that have high Hit chance, or a way to buff their Hit, so you're not constantly missing attacks. As with all the trials, you'll also want to bring at least one magic user to deal with the heavily armoured units that show up. Just make sure to check the combat predictions whenever you attack with them since they can take a ton of damage from physical counter-attacks. God Trials are essentially two back-to-back clashes against enemies buffed by the god's blessing. After you beat both waves of enemies, you'll be rewarded with the god's Supreme Arc, which are some of the strongest items and equipment in the game.",
      "url": "https://game8.co/games/Fire-Emblem-Fortunes-Weave/archives/627434",
      "raw_source": "raw_extracts/guides/kallas_trial_627434.html"
    },
    {
      "trial_name": "Credna's Trial",
      "god": "Credna",
      "unlock_condition": "Complete Credna's Request in Part 3.",
      "enemy_buffs": [
        "Any Master Class",
        "Any Divine Class",
        "Any Character"
      ],
      "rewards": [],
      "strategy": "Credna's Trial is arguably the easiest one, since you'll only need to worry about enemies always attacking first. You can pretty much use any character that you want for this fight, but you could also consider bringing units with high Avoid or defensive stats so you can dodge or tank all of the enemies' attacks. As with all the trials, you'll also want to bring at least one magic user to deal with the heavily armoured units that show up. Just make sure to check the combat predictions whenever you attack with them since they can take a ton of damage from physical counter-attacks. God Trials are essentially two back-to-back clashes against enemies buffed by the god's blessing. After you beat both waves of enemies, you'll be rewarded with the god's Supreme Arc, which are some of the strongest items and equipment in the game.",
      "url": "https://game8.co/games/Fire-Emblem-Fortunes-Weave/archives/627956",
      "raw_source": "raw_extracts/guides/crednas_trial_627956.html"
    },
    {
      "trial_name": "Smyrnos's Trial",
      "god": "Smyrnos",
      "unlock_condition": "Complete Smyrnos's Request in Part 3.",
      "enemy_buffs": [
        "Wiseman The Avatar Olympia Ninae"
      ],
      "rewards": [
        "Smyrnos's Channels",
        "Agena Tome"
      ],
      "strategy": "God Trials are essentially two back-to-back clashes against enemies buffed by the god's blessing. After you beat both waves of enemies, you'll be rewarded with the god's Supreme Arc, which are some of the strongest items and equipment in the game.",
      "url": "https://game8.co/games/Fire-Emblem-Fortunes-Weave/archives/627957",
      "raw_source": "raw_extracts/guides/smyrnoss_trial_627957.html"
    },
    {
      "trial_name": "Mars's Trial",
      "god": "Mars",
      "unlock_condition": "Complete Mars's Request in Part 3.",
      "enemy_buffs": [
        "Castle Knight Great Knight Buccar Esmeralda Tobias Orchel"
      ],
      "rewards": [
        "Mars's Kneepads"
